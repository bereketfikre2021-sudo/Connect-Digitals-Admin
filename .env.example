# =============================================================================
# Connect Digitals — Admin Dashboard Environment Variables
# Copy to .env — NEVER commit .env to version control
# These variables are baked into the production build at build time (VITE_*)
# =============================================================================

# ── API base URL ──────────────────────────────────────────────────────────────
# Development: proxied through Vite dev server (leave as /api/v1)
VITE_API_URL=/api/v1

# Production: set to the full URL of your deployed backend
# VITE_API_URL=https://your-backend.example.com/api/v1

# NOTE: After changing this value you MUST rebuild: npm run build
